{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crypto-agent/contracts/trade-intent.v1.schema.json",
  "title": "TradeIntent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["idempotency_key", "symbol", "action", "side", "qty"],
  "properties": {
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "symbol": {"type": "string", "minLength": 1},
    "action": {"enum": ["OPEN", "INCREASE", "REDUCE", "CLOSE", "REVERSE"]},
    "side": {"enum": ["BUY", "SELL"]},
    "qty": {"type": "number", "exclusiveMinimum": 0},
    "stop_loss_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "take_profit_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "atr14": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "reason": {"type": "string"}
  }
}

